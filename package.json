{
  "name": "node-express-typescript-boilerplate",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aurel667/node-express-typescript-boilerplate.git"
  },
  "author": "Aurel KOLANI <aureliuskolani@gmail.com>",
  "description": "Ce boilerplate fournit une structure de base pour démarrer rapidement un projet Node.js avec Express et TypeScript, incluant des configurations pour le développement, la compilation et la gestion des dépendances.",
  "badges": [
    {
      "url": "https://img.shields.io/badge/node-%3E%3D18.0.0-brightgreen",
      "href": "https://nodejs.org",
      "description": "Node.js version"
    },
    {
      "url": "https://img.shields.io/badge/typescript-5.9.3-blue",
      "href": "https://www.typescriptlang.org",
      "description": "TypeScript"
    },
    {
      "url": "https://img.shields.io/badge/express-5.1.0-lightgrey",
      "href": "https://expressjs.com",
      "description": "Express framework"
    }
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "concurrently \"node dist/index.js\" \"npm run worker:start\"",
    "worker:start": "node dist/workers/index.worker.js",
    "dev": "concurrently \"nodemon src/index.ts\" \"npm run worker:dev\"",
    "worker:dev": "nodemon src/workers/index.worker.ts",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@bull-board/express": "^9.12.0",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "bull": "^4.16.5",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^7.0.9",
    "prisma": "^7.10.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bull": "^3.15.9",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^7.0.2",
    "concurrently": "^10.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
